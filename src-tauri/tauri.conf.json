{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusForge",
  "version": "0.2.0",
  "identifier": "com.henrystewart.focusforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FocusForge",
        "width": 1220,
        "height": 880,
        "resizable": true,
        "minWidth": 380,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
