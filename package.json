{
  "name": "focusforge",
  "version": "0.2.0",
  "description": "A calm, local-first focus workspace with intentions and insights",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests README.md package.json vite.config.js index.html",
    "format:check": "prettier --check src tests README.md package.json vite.config.js index.html"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
